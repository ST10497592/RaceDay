@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var picture = string.IsNullOrWhiteSpace(Model.ProfilePictureUrl) ? Url.Content("~/images/avatar-placeholder.svg") : Model.ProfilePictureUrl;
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">@Model.Role</div>
        <h1>My profile</h1>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="rd-card rd-card-body text-center">
            <img id="avatar-preview" class="rd-avatar rd-avatar-lg mb-3" src="@picture" data-fallback="@Url.Content("~/images/avatar-placeholder.svg")" alt="Your profile picture" width="120" height="120" />
            <h3 class="mb-0">@Model.FirstName @Model.LastName</h3>
            <p class="text-muted">@Model.Email</p>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" data-once>
                <label for="picture" class="form-label visually-hidden">Choose a profile picture</label>
                <input id="picture" name="picture" type="file" class="form-control mb-2" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="avatar-preview" required />
                <div class="form-text mb-3">JPG, PNG, GIF or WEBP, up to 5 MB.</div>
                <button type="submit" class="btn btn-navy w-100"><i class="bi bi-cloud-arrow-up me-1"></i> Upload picture</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="rd-card rd-card-body">
            <h3 class="mb-3">Personal details</h3>
            <form asp-action="Profile" method="post" novalidate data-once>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="email-readonly">Email address</label>
                        <input id="email-readonly" class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" max="@(DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-accent mt-4">Save changes</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
