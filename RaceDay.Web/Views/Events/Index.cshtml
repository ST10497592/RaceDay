@model EventListViewModel
@{
    ViewData["Title"] = "Browse events";
    var q = Model.Query;
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Find your race</div>
        <h1>Browse events</h1>
    </div>
</div>

<form method="get" asp-action="Index" class="rd-card rd-card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4">
            <label for="Search" class="form-label">Search</label>
            <input id="Search" name="Search" class="form-control" value="@q.Search" placeholder="Event name or location" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="Type" class="form-label">Type</label>
            <select id="Type" name="Type" class="form-select">
                <option value="">All types</option>
                @foreach (var type in EventFormViewModel.EventTypes)
                {
                    <option value="@type" selected="@(q.Type == type)">@type</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label for="FromDate" class="form-label">From</label>
            <input id="FromDate" name="FromDate" type="date" class="form-control" value="@(q.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-2">
            <label for="ToDate" class="form-label">To</label>
            <input id="ToDate" name="ToDate" type="date" class="form-control" value="@(q.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-navy flex-fill"><i class="bi bi-search"></i> Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters" aria-label="Clear filters"><i class="bi bi-x-lg"></i></a>
        </div>
    </div>
    <div class="form-check mt-3">
        <input class="form-check-input" type="checkbox" id="Upcoming" name="Upcoming" value="true" checked="@q.Upcoming" />
        <label class="form-check-label" for="Upcoming">Only upcoming events</label>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning"><i class="bi bi-wifi-off me-2"></i>@Model.Error</div>
}
else if (Model.Events.Count == 0)
{
    <div class="rd-card rd-empty"><i class="bi bi-calendar-x"></i>No events match your search. Try changing the filters.</div>
}
else
{
    <p class="text-muted">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</p>
    <div class="row g-4">
        @foreach (var item in Model.Events)
        {
            <div class="col-md-6 col-xl-4"><partial name="_EventCard" model="item" /></div>
        }
    </div>
}
