@model List<EventSummaryDto>
@{
    ViewData["Title"] = "Enrolments";
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Organiser console</div>
        <h1>Enrolments</h1>
    </div>
</div>
<p class="text-muted">Choose an event to review its participants.</p>

@if (Model.Count == 0)
{
    <div class="rd-card rd-empty"><i class="bi bi-person-check"></i>You have no events yet.</div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table">
            <thead><tr><th>Event</th><th>Date</th><th>Total</th><th>Pending</th><th>Confirmed</th><th class="text-end"></th></tr></thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td class="fw-semibold">@e.EventName</td>
                    <td>@FormatHelper.ShortDate(e.EventDate)</td>
                    <td>@e.EnrolmentCount / @e.MaxParticipants</td>
                    <td>@if (e.PendingCount > 0) { <span class="rd-badge rd-badge-amber">@e.PendingCount</span> } else { <span class="text-muted">0</span> }</td>
                    <td>@e.ConfirmedCount</td>
                    <td class="text-end"><a class="btn btn-sm btn-navy" asp-action="Manage" asp-route-id="@e.EventId">Review</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
