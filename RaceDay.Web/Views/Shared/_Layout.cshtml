@inject UserSession Me
@{
    var controller = (ViewContext.RouteData.Values["controller"] ?? string.Empty).ToString() ?? string.Empty;
    var action = (ViewContext.RouteData.Values["action"] ?? string.Empty).ToString() ?? string.Empty;
    string Active(string c, string a = "")
    {
        var sameController = string.Equals(controller, c, StringComparison.OrdinalIgnoreCase);
        var sameAction = a == "" || string.Equals(action, a, StringComparison.OrdinalIgnoreCase);
        return sameController && sameAction ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" />
    <title>@ViewData["Title"] - RaceDay</title>
</head>
<body>
    <a class="visually-hidden-focusable position-absolute p-2 bg-white" href="#main-content">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-lg rd-navbar" data-bs-theme="dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-lightning-charge-fill"></i> RaceDay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index">Browse events</a></li>
                        @if (Me.IsParticipant)
                        {
                            <li class="nav-item"><a class="nav-link @Active("Participant", "MyEnrolments")" asp-controller="Participant" asp-action="MyEnrolments">My enrolments</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults">My results</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (Me.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <partial name="_Avatar" model="@(Me.ProfilePictureUrl ?? string.Empty)" />
                                    <span>@Me.FirstName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted">Signed in as<br /><strong>@Me.Email</strong></span></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-2"></i>My profile</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link @Active("Account", "Login")" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-accent btn-sm ms-lg-1" asp-controller="Account" asp-action="Register">Create account</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container py-4">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="rd-footer py-4 mt-4">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><i class="bi bi-lightning-charge-fill" style="color:var(--rd-orange)"></i> RaceDay - run, walk or ride your next race.</span>
            <span>&copy; @DateTime.Now.Year RaceDay</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
