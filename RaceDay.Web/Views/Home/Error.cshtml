@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="text-center py-5">
    <div class="rd-error-code">@Model.StatusCode</div>
    <h1 class="mb-3">@Model.Title</h1>
    <p class="text-muted mx-auto" style="max-width:32rem">@Model.Message</p>
    <div class="d-flex justify-content-center gap-2 mt-4">
        <a class="btn btn-accent" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i> Back to home</a>
        <a class="btn btn-outline-navy" asp-controller="Events" asp-action="Index">Browse events</a>
    </div>
</div>
