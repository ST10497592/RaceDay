@model CategoryListViewModel
@{
    ViewData["Title"] = "Categories";
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Organiser console</div>
        <h1>Categories</h1>
    </div>
    <a class="btn btn-accent" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New category</a>
</div>

@if (Model.Categories.Count == 0)
{
    <div class="rd-card rd-empty"><i class="bi bi-tags"></i>No categories yet. Add groups such as "Under 18" or "Open".</div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table">
            <thead><tr><th>Name</th><th>Age range</th><th>Description</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var c in Model.Categories)
            {
                <tr>
                    <td class="fw-semibold">@c.CategoryName</td>
                    <td>@c.AgeRangeText</td>
                    <td class="text-muted">@c.Description</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-navy" asp-action="Edit" asp-route-id="@c.CategoryId"><i class="bi bi-pencil"></i> Edit</a>
                        <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" class="d-inline" data-confirm="Delete the category '@c.CategoryName'?">
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
