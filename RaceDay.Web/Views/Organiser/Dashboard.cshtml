@model OrganiserDashboardViewModel
@inject UserSession Me
@{
    ViewData["Title"] = "Dashboard";
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Organiser console</div>
        <h1>Hello, @Me.FirstName</h1>
    </div>
    <a class="btn btn-accent" asp-controller="OrganiserEvents" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New event</a>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-warning"><i class="bi bi-wifi-off me-2"></i>@Model.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><div class="rd-stat"><div class="value">@Model.TotalEvents</div><div class="label">Events</div></div></div>
    <div class="col-6 col-xl-3"><div class="rd-stat lime"><div class="value">@Model.OpenEvents</div><div class="label">Open for enrolment</div></div></div>
    <div class="col-6 col-xl-3"><div class="rd-stat navy"><div class="value">@Model.TotalEnrolments</div><div class="label">Enrolments</div></div></div>
    <div class="col-6 col-xl-3"><div class="rd-stat amber"><div class="value">@Model.PendingEnrolments</div><div class="label">Awaiting confirmation</div></div></div>
</div>

<div class="rd-card">
    <div class="d-flex justify-content-between align-items-center p-3 pb-0">
        <h3 class="mb-0">Your events</h3>
        <a asp-controller="OrganiserEvents" asp-action="Index" class="fw-semibold">Manage all</a>
    </div>
    @if (Model.Events.Count == 0)
    {
        <div class="rd-empty"><i class="bi bi-calendar-plus"></i>You have not created any events yet.
            <div class="mt-3"><a class="btn btn-accent" asp-controller="OrganiserEvents" asp-action="Create">Create your first event</a></div>
        </div>
    }
    else
    {
        <div class="table-responsive p-2">
            <table class="table rd-table">
                <thead><tr><th>Event</th><th>Date</th><th>Status</th><th>Enrolled</th><th>Pending</th><th class="text-end">Shortcuts</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Events)
                {
                    <tr>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@FormatHelper.ShortDate(e.EventDate)</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td>@e.EnrolmentCount / @e.MaxParticipants</td>
                        <td>@if (e.PendingCount > 0) { <span class="rd-badge rd-badge-amber">@e.PendingCount pending</span> } else { <span class="text-muted">0</span> }</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-navy" asp-controller="OrganiserEnrolments" asp-action="Manage" asp-route-id="@e.EventId">Enrolments</a>
                            <a class="btn btn-sm btn-outline-navy" asp-controller="OrganiserResults" asp-action="Manage" asp-route-id="@e.EventId">Results</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
