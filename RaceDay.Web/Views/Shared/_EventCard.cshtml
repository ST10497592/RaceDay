@model EventDto
<div class="rd-card rd-card-hover h-100 d-flex flex-column">
    <img class="rd-event-banner"
         src="@(string.IsNullOrWhiteSpace(Model.BannerUrl) ? Url.Content("~/images/event-placeholder.svg") : Model.BannerUrl)"
         data-fallback="@Url.Content("~/images/event-placeholder.svg")" alt="Banner for @Model.EventName" loading="lazy" />
    <div class="rd-card-body d-flex flex-column flex-grow-1">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <span class="rd-eyebrow"><i class="bi @FormatHelper.EventTypeIcon(Model.EventType)"></i> @Model.EventType</span>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>
        <h3 class="mb-2"><a class="text-decoration-none text-reset stretched-link" asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId">@Model.EventName</a></h3>
        <div class="rd-event-meta mb-1"><i class="bi bi-calendar-event"></i>@FormatHelper.Date(Model.EventDate) at @FormatHelper.Time(Model.StartTime)</div>
        <div class="rd-event-meta mb-3"><i class="bi bi-geo-alt-fill"></i>@Model.Location</div>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="rd-price">@FormatHelper.Money(Model.EntryFee)</span>
            <span class="rd-event-meta"><i class="bi bi-people-fill"></i>@Model.MaxParticipants spots</span>
        </div>
    </div>
</div>
