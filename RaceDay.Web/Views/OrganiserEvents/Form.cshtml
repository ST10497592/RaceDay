@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "New event";
    var bannerSrc = string.IsNullOrWhiteSpace(Model.BannerUrl) ? Url.Content("~/images/event-placeholder.svg") : Model.BannerUrl;
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Organiser console</div>
        <h1>@(Model.IsEdit ? "Edit event" : "New event")</h1>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
</div>

<form asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@(Model.IsEdit ? Model.EventId : (int?)null)" method="post" enctype="multipart/form-data" novalidate data-once>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="rd-card rd-card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="EventName" class="form-label"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select" asp-items="@(EventFormViewModel.EventTypes.Select(t => new SelectListItem(t, t)))"></select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="@(EventFormViewModel.Statuses.Select(s => new SelectListItem(s, s)))"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StartTime" class="form-label"></label>
                        <input asp-for="StartTime" type="time" class="form-control" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EntryFee" class="form-label"></label>
                        <input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="EntryFee" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="rd-card rd-card-body">
                <h3 class="mb-3">Event banner</h3>
                <img id="banner-preview" src="@bannerSrc" data-fallback="@Url.Content("~/images/event-placeholder.svg")" alt="Banner preview"
                     class="w-100 mb-3" style="height:150px;object-fit:cover;border-radius:10px" />
                <label asp-for="Banner" class="form-label"></label>
                <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/gif,image/webp" data-preview="banner-preview" />
                <div class="form-text">JPG, PNG, GIF or WEBP, up to 5 MB. Stored securely in Azure Blob Storage.</div>
                <span asp-validation-for="Banner" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-accent btn-lg w-100 mt-3">@(Model.IsEdit ? "Save changes" : "Create event")</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
