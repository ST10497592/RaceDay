@inject UserSession Me
@model bool?
@{
    var showBrand = Model != false;
    var controller = (ViewContext.RouteData.Values["controller"] ?? string.Empty).ToString() ?? string.Empty;
    string Active(string c)
    {
        return string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
@if (showBrand)
{
    <a class="brand" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-lightning-charge-fill"></i> RaceDay</a>
    <div class="role-tag">Organiser console</div>
}
<nav class="nav flex-column gap-1">
    <a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a>
    <div class="nav-section">Manage</div>
    <a class="nav-link @Active("OrganiserEvents")" asp-controller="OrganiserEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> My events</a>
    <a class="nav-link @Active("OrganiserCategories")" asp-controller="OrganiserCategories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a>
    <a class="nav-link @Active("OrganiserEnrolments")" asp-controller="OrganiserEnrolments" asp-action="Index"><i class="bi bi-person-check"></i> Enrolments</a>
    <a class="nav-link @Active("OrganiserResults")" asp-controller="OrganiserResults" asp-action="Index"><i class="bi bi-trophy"></i> Results</a>
    <div class="nav-section">Account</div>
    <a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i> My profile</a>
    <a class="nav-link @Active("Events")" asp-controller="Events" asp-action="Index"><i class="bi bi-globe2"></i> Public events page</a>
</nav>
<div class="user-box mt-auto">
    <div class="d-flex align-items-center gap-2 mb-3">
        <partial name="_Avatar" model="@(Me.ProfilePictureUrl ?? string.Empty)" />
        <div class="small lh-sm">
            <div class="fw-semibold">@Me.FullName</div>
            <div class="text-white-50">@Me.Email</div>
        </div>
    </div>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="btn btn-outline-light btn-sm w-100"><i class="bi bi-box-arrow-right me-1"></i> Sign out</button>
    </form>
</div>
