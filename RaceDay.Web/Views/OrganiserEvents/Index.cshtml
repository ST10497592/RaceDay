@model List<EventSummaryDto>
@{
    ViewData["Title"] = "My events";
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Organiser console</div>
        <h1>My events</h1>
    </div>
    <a class="btn btn-accent" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> New event</a>
</div>

@if (Model.Count == 0)
{
    <div class="rd-card rd-empty"><i class="bi bi-calendar-plus"></i>No events yet. Create one to get started.</div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table">
            <thead><tr><th>Event</th><th>Date</th><th>Type</th><th>Status</th><th>Categories</th><th>Enrolled</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <img src="@(string.IsNullOrWhiteSpace(e.BannerUrl) ? Url.Content("~/images/event-placeholder.svg") : e.BannerUrl)"
                                 data-fallback="@Url.Content("~/images/event-placeholder.svg")" alt="" width="64" height="40" style="object-fit:cover;border-radius:8px" />
                            <div>
                                <a class="fw-semibold text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                                <div class="small text-muted">@e.Location</div>
                            </div>
                        </div>
                    </td>
                    <td>@FormatHelper.ShortDate(e.EventDate)<div class="small text-muted">@FormatHelper.Time(e.StartTime)</div></td>
                    <td>@e.EventType</td>
                    <td><partial name="_StatusBadge" model="e.Status" /></td>
                    <td>@e.CategoryCount</td>
                    <td>@e.EnrolmentCount / @e.MaxParticipants</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-navy" asp-action="Categories" asp-route-id="@e.EventId" title="Categories"><i class="bi bi-tags"></i></a>
                        <a class="btn btn-sm btn-outline-navy" asp-action="Edit" asp-route-id="@e.EventId" title="Edit"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline" data-confirm="Delete '@e.EventName'? This cannot be undone.">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
