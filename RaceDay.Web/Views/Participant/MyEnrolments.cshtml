@model MyEnrolmentsViewModel
@{
    ViewData["Title"] = "My enrolments";
}
<div class="rd-page-header">
    <div>
        <div class="rd-eyebrow">Participant</div>
        <h1>My enrolments</h1>
    </div>
    <a class="btn btn-accent" asp-controller="Events" asp-action="Index"><i class="bi bi-plus-lg me-1"></i> Find an event</a>
</div>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-card rd-empty">
        <i class="bi bi-ticket-perforated"></i>
        You have not enrolled in any events yet.
        <div class="mt-3"><a class="btn btn-accent" asp-controller="Events" asp-action="Index">Browse events</a></div>
    </div>
}
else
{
    <div class="rd-card table-responsive">
        <table class="table rd-table">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Status</th><th>Payment</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
            @foreach (var e in Model.Enrolments)
            {
                <tr>
                    <td>
                        <a class="fw-semibold text-decoration-none" asp-controller="Events" asp-action="Details" asp-route-id="@e.EventId">@e.EventName</a>
                        <div class="small text-muted"><i class="bi bi-geo-alt"></i> @e.EventLocation</div>
                    </td>
                    <td>@FormatHelper.ShortDate(e.EventDate)</td>
                    <td>@e.CategoryName</td>
                    <td><partial name="_StatusBadge" model="e.Status" /></td>
                    <td><partial name="_StatusBadge" model="e.PaymentStatus" /></td>
                    <td class="text-end">
                        @if (e.ResultId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-navy" asp-action="MyResults">View result</a>
                        }
                        else if (e.Status == "Pending" || e.Status == "Confirmed")
                        {
                            <form asp-action="CancelEnrolment" asp-route-id="@e.EnrolmentId" method="post" class="d-inline" data-confirm="Cancel your enrolment in @e.EventName?">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
